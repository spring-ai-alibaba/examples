# Docker build context exclusions for backend
# Maven
**/target/
**/*.jar
**/*.war
**/*.ear

# Maven wrapper (not needed in container)
.mvn/
mvnw
mvnw.cmd

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/

# Git
.git/
.gitignore
.gitattributes

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Documentation (not needed in build)
*.md

# Environment files
.env
.env.local
.env.*.local

# Test files
**/src/test/

# Docker files themselves
Dockerfile*
.dockerignore
